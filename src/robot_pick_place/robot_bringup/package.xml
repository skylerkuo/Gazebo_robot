<?xml version="1.0"?>
<package format="3">
  <name>robot_bringup</name><version>0.1.0</version>
  <description>Robot profile parsing and integrated Gazebo/MoveIt/task launch.</description>
  <maintainer email="skylerkuo@users.noreply.github.com">Skyler Kuo</maintainer>
  <license>BSD-3-Clause</license>
  <buildtool_depend>python3-setuptools</buildtool_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend><exec_depend>launch_ros</exec_depend>
  <exec_depend>rclpy</exec_depend><exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-psutil</exec_depend>
  <exec_depend>xacro</exec_depend><exec_depend>moveit_configs_utils</exec_depend>
  <exec_depend>sensor_msgs</exec_depend><exec_depend>moveit_msgs</exec_depend>
  <exec_depend>controller_manager_msgs</exec_depend><exec_depend>tf2_ros_py</exec_depend>
  <exec_depend>robot_task_interfaces</exec_depend>
  <exec_depend>robot_task_core</exec_depend><exec_depend>robot_perception</exec_depend>
  <exec_depend>mycobot_description</exec_depend><exec_depend>mycobot_gazebo</exec_depend>
  <exec_depend>mycobot_moveit_config</exec_depend>
  <exec_depend>kinova_gen3_lite_support</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
