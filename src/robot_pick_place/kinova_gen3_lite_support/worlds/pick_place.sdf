<?xml version="1.0"?>
<sdf version="1.9">
  <world name="default">
    <physics name="default" type="ignored"><max_step_size>0.001</max_step_size><real_time_factor>1</real_time_factor></physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"><render_engine>ogre2</render_engine></plugin>
    <light name="sun" type="directional">
      <pose>0 0 5 0 0 0</pose><diffuse>0.8 0.8 0.8 1</diffuse><specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction><cast_shadows>true</cast_shadows>
    </light>
    <model name="ground"><static>true</static><link name="ground_link">
      <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>5 5</size></plane></geometry></collision>
      <visual name="visual"><geometry><plane><normal>0 0 1</normal><size>5 5</size></plane></geometry>
        <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
      </visual>
    </link></model>
    <model name="target_cylinder"><pose>0.35 0.15 0.175 0 0 0</pose><link name="object_link">
      <inertial><mass>0.05</mass><inertia><ixx>0.00052</ixx><iyy>0.00052</iyy><izz>0.00001</izz></inertia></inertial>
      <collision name="collision"><geometry><cylinder><radius>0.02</radius><length>0.35</length></cylinder></geometry></collision>
      <visual name="visual"><geometry><cylinder><radius>0.02</radius><length>0.35</length></cylinder></geometry>
        <material><ambient>0.8 0.05 0.05 1</ambient><diffuse>0.8 0.05 0.05 1</diffuse></material>
      </visual>
    </link></model>
    <!-- Small household props sized for the Lite 2F jaws. All are dynamic, separate objects. -->
    <model name="orange"><pose>0.24 0.28 0.026 0 0 0</pose><link name="fruit_link">
      <inertial><mass>0.04</mass><inertia><ixx>0.000010816</ixx><iyy>0.000010816</iyy><izz>0.000010816</izz></inertia></inertial>
      <collision name="collision"><geometry><sphere><radius>0.026</radius></sphere></geometry></collision>
      <visual name="fruit"><geometry><sphere><radius>0.026</radius></sphere></geometry>
        <material><ambient>1 0.35 0.02 1</ambient><diffuse>1 0.35 0.02 1</diffuse></material>
      </visual>
      <visual name="stem"><pose>0 0 0.026 0 0 0</pose><geometry><cylinder><radius>0.004</radius><length>0.003</length></cylinder></geometry>
        <material><ambient>0.15 0.35 0.03 1</ambient><diffuse>0.15 0.35 0.03 1</diffuse></material>
      </visual>
    </link></model>
    <model name="apple"><pose>0.40 0.02 0.025 0 0 0</pose><link name="fruit_link">
      <inertial><mass>0.04</mass><inertia><ixx>0.00001</ixx><iyy>0.00001</iyy><izz>0.00001</izz></inertia></inertial>
      <collision name="collision"><geometry><sphere><radius>0.025</radius></sphere></geometry></collision>
      <visual name="fruit"><geometry><sphere><radius>0.025</radius></sphere></geometry>
        <material><ambient>0.75 0.02 0.03 1</ambient><diffuse>0.75 0.02 0.03 1</diffuse></material>
      </visual>
      <visual name="stem"><pose>0 0 0.027 0 0.25 0</pose><geometry><cylinder><radius>0.002</radius><length>0.012</length></cylinder></geometry>
        <material><ambient>0.25 0.1 0.02 1</ambient><diffuse>0.25 0.1 0.02 1</diffuse></material>
      </visual>
    </link></model>
    <model name="drink_can"><pose>0.30 -0.02 0.05 0 0 0</pose><link name="can_link">
      <inertial><mass>0.04</mass><inertia><ixx>0.0000373333</ixx><iyy>0.0000373333</iyy><izz>0.000008</izz></inertia></inertial>
      <collision name="collision"><geometry><cylinder><radius>0.02</radius><length>0.1</length></cylinder></geometry></collision>
      <visual name="body"><geometry><cylinder><radius>0.02</radius><length>0.1</length></cylinder></geometry>
        <material><ambient>0.03 0.3 0.85 1</ambient><diffuse>0.03 0.3 0.85 1</diffuse></material>
      </visual>
      <visual name="label"><pose>0 0 0.005 0 0 0</pose><geometry><cylinder><radius>0.0202</radius><length>0.025</length></cylinder></geometry>
        <material><ambient>0.92 0.92 0.92 1</ambient><diffuse>0.92 0.92 0.92 1</diffuse></material>
      </visual>
      <visual name="lid"><pose>0 0 0.0501 0 0 0</pose><geometry><cylinder><radius>0.019</radius><length>0.001</length></cylinder></geometry>
        <material><ambient>0.65 0.65 0.65 1</ambient><diffuse>0.65 0.65 0.65 1</diffuse></material>
      </visual>
    </link></model>
    <model name="small_carton"><pose>0.28 -0.30 0.0325 0 0 0.2</pose><link name="carton_link">
      <inertial><mass>0.03</mass><inertia><ixx>0.000013625</ixx><iyy>0.000015625</iyy><izz>0.000008125</izz></inertia></inertial>
      <collision name="collision"><geometry><box><size>0.045 0.035 0.065</size></box></geometry></collision>
      <visual name="body"><geometry><box><size>0.045 0.035 0.065</size></box></geometry>
        <material><ambient>0.65 0.4 0.16 1</ambient><diffuse>0.65 0.4 0.16 1</diffuse></material>
      </visual>
      <visual name="label"><pose>0 -0.0176 0 0 0 0</pose><geometry><box><size>0.03 0.0005 0.035</size></box></geometry>
        <material><ambient>0.2 0.65 0.25 1</ambient><diffuse>0.2 0.65 0.25 1</diffuse></material>
      </visual>
    </link></model>
  </world>
</sdf>
