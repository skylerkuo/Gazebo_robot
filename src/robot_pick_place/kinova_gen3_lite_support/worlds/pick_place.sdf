<?xml version="1.0"?>
<sdf version="1.9">
  <world name="default">
    <physics name="default" type="ignored"><max_step_size>0.001</max_step_size><real_time_factor>1</real_time_factor></physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"><render_engine>ogre2</render_engine></plugin>
    <light name="sun" type="directional">
      <pose>0 0 5 0 0 0</pose><diffuse>0.8 0.8 0.8 1</diffuse><specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction><cast_shadows>true</cast_shadows>
    </light>
    <model name="ground"><static>true</static><link name="ground_link">
      <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>5 5</size></plane></geometry></collision>
      <visual name="visual"><geometry><plane><normal>0 0 1</normal><size>5 5</size></plane></geometry>
        <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
      </visual>
    </link></model>
    <!-- Small household props sized for the Lite 2F jaws. All are dynamic, separate objects. -->
    <model name="orange"><pose>0.24 0.28 0.026 0 0 0</pose><link name="fruit_link">
      <inertial><mass>0.04</mass><inertia><ixx>0.000010816</ixx><iyy>0.000010816</iyy><izz>0.000010816</izz></inertia></inertial>
      <collision name="collision"><geometry><sphere><radius>0.026</radius></sphere></geometry></collision>
      <visual name="fruit"><geometry><sphere><radius>0.026</radius></sphere></geometry>
        <material><ambient>1 0.35 0.02 1</ambient><diffuse>1 0.35 0.02 1</diffuse></material>
      </visual>
      <visual name="stem"><pose>0 0 0.026 0 0 0</pose><geometry><cylinder><radius>0.004</radius><length>0.003</length></cylinder></geometry>
        <material><ambient>0.15 0.35 0.03 1</ambient><diffuse>0.15 0.35 0.03 1</diffuse></material>
      </visual>
    </link></model>
    <model name="drink_can"><pose>0.30 -0.02 0.05 0 0 0</pose><link name="can_link">
      <inertial><mass>0.04</mass><inertia><ixx>0.0000373333</ixx><iyy>0.0000373333</iyy><izz>0.000008</izz></inertia></inertial>
      <collision name="collision"><geometry><cylinder><radius>0.02</radius><length>0.1</length></cylinder></geometry></collision>
      <visual name="body"><geometry><cylinder><radius>0.02</radius><length>0.1</length></cylinder></geometry>
        <material><ambient>0.03 0.3 0.85 1</ambient><diffuse>0.03 0.3 0.85 1</diffuse></material>
      </visual>
      <visual name="label"><pose>0 0 0.005 0 0 0</pose><geometry><cylinder><radius>0.0202</radius><length>0.025</length></cylinder></geometry>
        <material><ambient>0.92 0.92 0.92 1</ambient><diffuse>0.92 0.92 0.92 1</diffuse></material>
      </visual>
      <visual name="lid"><pose>0 0 0.0501 0 0 0</pose><geometry><cylinder><radius>0.019</radius><length>0.001</length></cylinder></geometry>
        <material><ambient>0.65 0.65 0.65 1</ambient><diffuse>0.65 0.65 0.65 1</diffuse></material>
      </visual>
    </link></model>
    <!-- Red mug: cylindrical grasp body, dark opening and a visible handle. -->
    <model name="red_mug"><pose>0.28 -0.25 0.035 0 0 0</pose><link name="mug_link">
      <inertial><mass>0.04</mass><inertia><ixx>0.0000211733</ixx><iyy>0.0000211733</iyy><izz>0.00000968</izz></inertia></inertial>
      <collision name="collision"><geometry><cylinder><radius>0.022</radius><length>0.07</length></cylinder></geometry></collision>
      <visual name="body"><geometry><cylinder><radius>0.022</radius><length>0.07</length></cylinder></geometry><material><ambient>0.85 0.025 0.025 1</ambient><diffuse>0.85 0.025 0.025 1</diffuse></material></visual>
      <visual name="opening"><pose>0 0 0.0352 0 0 0</pose><geometry><cylinder><radius>0.019</radius><length>0.0004</length></cylinder></geometry><material><ambient>0.06 0.015 0.015 1</ambient><diffuse>0.06 0.015 0.015 1</diffuse></material></visual>
      <!-- Handle is visual only; grasp/contact model remains the cylindrical body. -->
      <visual name="handle_top"><pose>0.029 0 0.021 0 0 0</pose><geometry><box><size>0.022 0.007 0.007</size></box></geometry><material><ambient>0.85 0.025 0.025 1</ambient><diffuse>0.85 0.025 0.025 1</diffuse></material></visual>
      <visual name="handle_outer"><pose>0.037 0 0 0 0 0</pose><geometry><box><size>0.007 0.007 0.049</size></box></geometry><material><ambient>0.85 0.025 0.025 1</ambient><diffuse>0.85 0.025 0.025 1</diffuse></material></visual>
      <visual name="handle_bottom"><pose>0.029 0 -0.021 0 0 0</pose><geometry><box><size>0.022 0.007 0.007</size></box></geometry><material><ambient>0.85 0.025 0.025 1</ambient><diffuse>0.85 0.025 0.025 1</diffuse></material></visual>
    </link></model>
    <!-- Narrow-neck bottle: body/shoulder/neck/cap distinguish it from a plain cylinder. -->
    <model name="plastic_bottle"><pose>0.35 0.15 0.06 0 0 0</pose><link name="bottle_link">
      <inertial><mass>0.035</mass><inertia><ixx>0.000044835</ixx><iyy>0.000044835</iyy><izz>0.00000567</izz></inertia></inertial>
      <!-- Conservative cylindrical envelope, consistent with the primitive grasp model. -->
      <collision name="collision"><geometry><cylinder><radius>0.018</radius><length>0.12</length></cylinder></geometry></collision>
      <visual name="body"><pose>0 0 -0.02 0 0 0</pose><geometry><cylinder><radius>0.018</radius><length>0.08</length></cylinder></geometry>
        <material><ambient>0.1 0.65 0.15 1</ambient><diffuse>0.1 0.65 0.15 1</diffuse></material>
      </visual>
      <visual name="label"><pose>0 0 -0.01 0 0 0</pose><geometry><cylinder><radius>0.0182</radius><length>0.025</length></cylinder></geometry>
        <material><ambient>0.95 0.95 0.85 1</ambient><diffuse>0.95 0.95 0.85 1</diffuse></material>
      </visual>
      <visual name="shoulder"><pose>0 0 0.024 0 0 0</pose><geometry><sphere><radius>0.017</radius></sphere></geometry><material><ambient>0.1 0.65 0.15 1</ambient><diffuse>0.1 0.65 0.15 1</diffuse></material></visual>
      <visual name="neck"><pose>0 0 0.043 0 0 0</pose><geometry><cylinder><radius>0.009</radius><length>0.02</length></cylinder></geometry><material><ambient>0.1 0.65 0.15 1</ambient><diffuse>0.1 0.65 0.15 1</diffuse></material></visual>
      <visual name="cap"><pose>0 0 0.055 0 0 0</pose><geometry><cylinder><radius>0.01</radius><length>0.01</length></cylinder></geometry><material><ambient>0.03 0.1 0.6 1</ambient><diffuse>0.03 0.1 0.6 1</diffuse></material></visual>
    </link></model>
