<?xml version="1.0"?>
<robot name="gen3_lite_gen3_lite_2f" xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:arg name="controllers_file" default="$(find kinova_gen3_lite_support)/config/ros2_controllers.yaml"/>
  <xacro:arg name="use_camera" default="false"/>
  <xacro:include filename="$(find kortex_description)/robots/kortex_robot.xacro"/>
  <link name="world"/>
  <!-- Official arm and Gen3 Lite 2F geometry, inertias, limits and mimic relationships. -->
  <xacro:load_robot parent="world" arm="gen3_lite" dof="6" gripper="gen3_lite_2f"
    gripper_joint_name="right_finger_bottom_joint" prefix="" vision="false"
    robot_ip="unused-in-gazebo" username="admin" password="admin" port="10000" port_realtime="10001"
    session_inactivity_timeout_ms="60000" connection_inactivity_timeout_ms="2000"
    use_fake_hardware="false" sim_gazebo="true" moveit_active="false"
    initial_positions="${xacro.load_yaml('$(find kinova_gen3_lite_support)/config/initial_positions.yaml')}">
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </xacro:load_robot>
  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(arg controllers_file)</parameters>
      <controller_manager_name>controller_manager</controller_manager_name>
    </plugin>
  </gazebo>
  <!-- External scene camera, not an integrated Gen3 vision module. -->
  <xacro:if value="$(arg use_camera)">
    <link name="scene_camera_link">
      <inertial><mass value="0.1"/><inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/></inertial>
      <visual><geometry><box size="0.03 0.08 0.03"/></geometry>
        <material name="camera_black"><color rgba="0.1 0.1 0.1 1"/></material>
      </visual>
    </link>
    <joint name="scene_camera_joint" type="fixed">
      <parent link="base_link"/><child link="scene_camera_link"/>
      <origin xyz="0.4 -0.6 0.9" rpy="0 0.85 1.57079632679"/>
    </joint>
    <gazebo reference="scene_camera_link">
      <sensor name="scene_rgbd" type="rgbd_camera">
        <topic>camera_head</topic><gz_frame_id>scene_camera_link</gz_frame_id>
        <always_on>true</always_on><update_rate>10</update_rate>
        <camera>
          <horizontal_fov>1.2</horizontal_fov>
          <image><width>640</width><height>480</height><format>R8G8B8</format></image>
          <clip><near>0.1</near><far>3.0</far></clip>
          <depth_camera><clip><near>0.1</near><far>3.0</far></clip></depth_camera>
        </camera>
      </sensor>
    </gazebo>
  </xacro:if>
</robot>
